# Copy to `.env` and fill in per environment. Every variable here is read through
# `import.meta.env`, which Vite inlines at BUILD time — changing one requires a rebuild,
# and the value ends up in the client bundle, so none of these may be a secret.

# The one origin the site is indexed under. Feeds every canonical URL, hreflang alternate,
# og:url, JSON-LD @id, and the sitemap. Must have no trailing slash. Defaults to
# https://choosy.com (see src/shared/config/siteMeta.js) when unset.
VITE_SITE_URL=https://choosy.com

# Google Analytics 4 measurement id (looks like G-XXXXXXXXXX). Leave EMPTY to ship no
# analytics at all: src/root.tsx renders the gtag script only when this is set, so preview
# and demo deploys stay script-free. Note that enabling this is what the "analytics" section
# of the privacy policy describes — the two are meant to be true together.
VITE_GA4_MEASUREMENT_ID=

# Google Search Console verification token — the `content` value of the
# <meta name="google-site-verification"> tag Search Console asks you to add. Leave EMPTY
# until the property is being verified; no tag is rendered while it is unset.
VITE_GSC_VERIFICATION=
